{
  "manifest_version": 3,
  "name": "CST-036 Navigation Redirect",
  "version": "1.0.0",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://accounts.example.test/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accounts.example.test/*"
      ],
      "js": [
        "nav.js"
      ]
    }
  ]
}
