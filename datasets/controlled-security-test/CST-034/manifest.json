{
  "manifest_version": 3,
  "name": "CST-034 DNR Redirect",
  "version": "1.0.0",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_redir",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
